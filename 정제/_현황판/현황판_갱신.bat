@echo off
chcp 65001 >nul
cd /d "%~dp0"
title 사주 정제 - 전체 갱신
echo.
echo   ===============================================
echo    사주 정제 - 전체 갱신 (8단계 파이프라인)
echo   ===============================================
echo.
echo    이 배치는 예전에 2개 스크립트만 불렀습니다.
echo    실제 단계는 8개라, 눌러도 화면 5개 중 2개만 갱신되고
echo    나머지는 낡은 채로 남아 최신인 척했습니다.
echo    이제 파이프라인 하나가 전부를 정해진 순서로 돌립니다.
echo.
echo    한 단계라도 실패하면 거기서 멈춥니다 (넘어가지 않습니다).
echo.

python 파이프라인.py --all
if errorlevel 1 (
  echo.
  echo   ===============================================
  echo    [멈춤] 위에 찍힌 실패 단계를 보세요.
  echo   ===============================================
  echo.
  echo    낡은 화면이 최신인 척하지 않도록 여기서 멈췄습니다.
  echo    python 이 없다면 먼저 설치하세요.
  echo.
  pause
  exit /b 1
)

echo.
echo   [완료] 허브를 엽니다 - 화면 5개와 낡음 상태를 한눈에 봅니다.
start "" "허브.html"
timeout /t 2 >nul
