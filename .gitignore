# 재생성 가능한 yt-dlp 원본 스크랩 데이터 (약 694MB)
# 영상 메타(.info.json) + 자막 트랙(.json3) 원본. 가공 결과(자막 텍스트)는 유튜브_자막_모음/에 있음.
# 원본은 _압축본_백업/ 의 분할 압축본에 보존됨.
youtube-tools/raw/

# Node / 빌드 산출물 (app/ 및 루트 위임 빌드)
node_modules/
dist/

# Python 캐시
__pycache__/
*.pyc

# JPL 천체력 (절기표 재생성 시 skyfield가 자동 다운로드, 32MB)
dosa-app/engine/tools/de440s.bsp

# L2 파생 산출물 (정제본에서 extract_bodies.py로 재생성, 13.5MB)
dosa-app/kb/unit_bodies.json
dosa-app/kb/distill_src/

# 앱 KB 번들 (scripts/build_kb.mjs가 생성 — prebuild에서 자동)
app/public/kb-*.json
app/src/engine/vendor/kb_ref.json

# ── 블라인드 격리(260726) — /feed 시험의 '답안지'는 레포에 두지 않는다 ──
# 왜: SKILL.md §23 "답안지가 레포에 있으면 학생이 grep으로 주울 수 있다".
#     zip은 파일명을 압축 없이 저장해 261개 영상 제목이 평문으로 노출된다(실측) = 제목이 곧 답.
# 삭제가 아니라 추적 해제다 — 파일은 디스크에 남고, git 히스토리에도 남는다.
#   복구: git show 0e266c1:'노뮤트_전사본_20260718.zip' > 노뮤트_전사본_20260718.zip
# 주입은 경로 인자로 돌아간다: python3 dosa-app/kb-tools/ingest_transcript.py <경로>
노뮤트_전사본_*.zip
_압축본_백업/
# 압축을 푼 자막본이 레포에 생기는 것도 차단(파도 작업 중 실수 방어)
*_자막/
dohwadore_saju_자막/

# OAuth 계정 로테이션(sticky failover) 신호 파일 — 실수 커밋 방지(이식팩 §2-e)
.nomute_active_quota

# 개인 설정 — 모델/노력도/권한 모드는 사람마다 다르고, 특히 권한은 공개 리포에
#   커밋하면 클론하는 모든 사람에게 적용된다. 팀 공통은 .claude/settings.json 에.
.claude/settings.local.json
